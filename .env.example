# LiveKit Cloud project (same as backend) - the local agent registers with Cloud using these
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match AGENT_NAME in backend/.env
AGENT_NAME=voice-agent

DEEPGRAM_API_KEY=
CEREBRAS_API_KEY=
CARTESIA_API_KEY=

# Backend the agent reports call status/transcripts to
BACKEND_URL=http://localhost:3001
# Must match AGENT_API_SECRET in backend/.env
AGENT_API_SECRET=

# The agent's end_call tool is ignored this many seconds after the callee answers (default 8)
# END_CALL_MIN_SECONDS=8

# External API tools can't reach private/localhost addresses unless this is 1 (local development only)
# API_TOOLS_ALLOW_PRIVATE=0

# Call recordings (only when the backend has storage configured). wav = 16 kHz stereo WAV,
# ogg = Ogg/Opus (about 10x smaller). Files that couldn't be uploaded stay in RECORDINGS_DIR and are
# retried after later calls; anything older than RECORDING_KEEP_DAYS is deleted.
# RECORDING_FORMAT=wav
# RECORDINGS_DIR=.cache/recordings
# RECORDING_KEEP_DAYS=7
# JOB_SHUTDOWN_SECONDS=120

# Scripted replies: agents with an enabled script answer matched turns with pre-synthesized
# lines and use the LLM only as a fallback. Off unless set to 1.
SCRIPTED_REPLIES=0
# Optional tuning
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# SCRIPT_MATCH_MARGIN=0.05
# SCRIPT_MATCH_TIMEOUT_MS=150
